<!DOCTYPE html>
<html>
<head>
  <title>Roblox Gift Card – Redeem</title>
  <style>
    body{background:#f5f5f5;font-family:Arial;text-align:center;padding:50px;}
    .card{background:white;max-width:400px;margin:auto;padding:30px;border-radius:10px;box-shadow:0 0 20px rgba(0,0,0,0.2);}
    p{color:#666;}
  </style>
</head>
<body>
<div class="card">
  <h2>🎮 Roblox Gift Card</h2>
